# Force npm à accepter les peer deps incompatibles.
# Raison : vite-plugin-pwa@1.2.0 a un peer dep `vite@<=7` mais on est sur
# vite@8 (compatible en pratique malgré la divergence de version). Sans
# ce flag, Vercel échoue son `npm install` strict.
# Fonctionne aussi en local pour aligner dev/prod.
legacy-peer-deps=true
