{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "baseUrl": ".",
    "paths": {
      "@app/*":       ["./src/app/*"],
      "@features/*":  ["./src/features/*"],
      "@shared/*":    ["./src/shared/*"],
      "@prerender/*": ["./src/prerender/*"]
    },
    "checkJs": false,
    "allowJs": true,
    "resolveJsonModule": true,
    "esModuleInterop": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "playwright-report", "test-results"]
}
